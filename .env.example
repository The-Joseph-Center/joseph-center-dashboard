VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
NETLIFY_SITE_ID=
STRIPE_CONFIG={"secretKey":"","publishableKey":"","webhookSecret":""}
JC_STRIPE_CONFIG={"secretKey":"","publishableKey":"","webhookSecret":""}

# Turso — content kit persistence (shared across pipeline)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: webhook URL for support request notifications
SIMPLE_ANALYTICS_API_KEY=

# Okta OIDC — staff sign in with their existing Okta account.
# No custom authorization server on this tenant, so the ID token audience
# is the client id and group claims only appear in the ID token.
VITE_OKTA_ISSUER=
VITE_OKTA_CLIENT_ID=
VITE_OKTA_ADMIN_GROUP=
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_ADMIN_GROUP=
# Okta API token — reads the staff directory for reconciliation and the
# onboarding queue. Server-side only.
OKTA_API_TOKEN=

# Sanity editor token — the dashboard writes staff quotes back to the CMS.
SANITY_WRITE_TOKEN=

# Resend — quote change requests are emailed for review.
RESEND_API_KEY=
QUOTE_REVIEW_TO_EMAIL=
QUOTE_REVIEW_FROM_EMAIL=

# The Price the client is billed on — anchors the billing summary.
BILLING_PRICE_ID=

# Where dashboard support requests go.
SUPPORT_TO_EMAIL=

# AI tooling — blog title/summary/category/tag suggestions.
# Use a service account key scoped to a single workspace; then
# ANTHROPIC_WORKSPACE_ID is not needed. Set it only if the key covers more
# than one workspace, otherwise every request fails with a 400.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# YouTube — pulls last month's Coffee Chat titles and links into the newsletter.
# Same values the frontend uses; titles must match the channel exactly, which is
# why they are read rather than typed.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Google Sheets — pulls the monthly program numbers into the newsletter.
#
# OAuth is the path that works here: the organization enforces
# iam.disableServiceAccountKeyCreation, so a service account key cannot be
# downloaded. Create an OAuth client (Desktop app), put the id and secret below,
# then run `node scripts/google-oauth.mjs` once for the refresh token.
# Set the consent screen User type to Internal — in Testing mode Google expires
# refresh tokens after seven days.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Alternative, if the org policy is ever given an exception for this project:
# the entire downloaded service account key file, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
NEWSLETTER_SHEET_ID=
# Optional: the default tab to read. Otherwise it is chosen in the dashboard.
NEWSLETTER_SHEET_TAB=

# AWeber — applies the monthly tag that triggers the newsletter automations.
# Needs wider scopes than the site's signup form: account.read, list.read,
# subscriber.read, subscriber.write, email.read, email.write. Run
# `node scripts/aweber-oauth.mjs` once to reauthorize.
AWEBER_CLIENT_ID=
AWEBER_CLIENT_SECRET=
AWEBER_REFRESH_TOKEN=
AWEBER_ACCOUNT_ID=
AWEBER_LIST_ID=
